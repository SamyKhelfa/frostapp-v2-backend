generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                       @id @default(autoincrement())
  email                   String                    @unique
  password                String
  name                    String
  role                    UserRolesEnum             @default(user)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  lessons                 Lesson[]
  active                  Boolean                   @default(true)
  emailVerified           Boolean                   @default(false)
  avatar                  String?
  passwordResetTokens     PasswordResetToken[]
  progress                UserProgress[]
  conversations           ConversationParticipant[]
  messages                Message[]
  createdConversations    Conversation[]            @relation("ConversationCreator")
  coldShowers             ColdShowerEntry[]
  notifications           Notification[]            @relation("NotificationRecipient")
  triggeredNotifications  Notification[]            @relation("NotificationActor")
  emailVerificationTokens EmailVerificationToken[]
}

model Lesson {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  users       User[]
  chapters    Chapter[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Chapter {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  image       String
  status      Boolean
  position    Int
  Lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    Int?
  subChapters SubChapter[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SubChapter {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  video       String
  duration    Int
  active      Boolean
  position    Int
  Chapter     Chapter?       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId   Int?
  status      Boolean
  progress    UserProgress[]
}

enum UserRolesEnum {
  admin
  user
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserProgress {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subChapterId Int
  subChapter   SubChapter @relation(fields: [subChapterId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@unique([userId, subChapterId])
  @@index([userId])
}

enum ConversationType {
  COMMUNITY
  DIRECT
}

enum JoinPolicy {
  OPEN
  APPROVAL
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ParticipantStatus {
  ACTIVE
  PENDING
}

model Conversation {
  id            Int                       @id @default(autoincrement())
  type          ConversationType
  pairKey       String?                   @unique
  name          String?
  description   String?
  image         String?
  joinPolicy    JoinPolicy                @default(OPEN)
  createdById   Int?
  createdBy     User?                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]
  notifications Notification[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model ConversationParticipant {
  id             Int               @id @default(autoincrement())
  role           ParticipantRole   @default(MEMBER)
  status         ParticipantStatus @default(ACTIVE)
  conversationId Int
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  muted          Boolean           @default(false)
  joinedAt       DateTime          @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum NotificationType {
  JOIN_REQUEST
  JOIN_APPROVED
}

model Notification {
  id             Int              @id @default(autoincrement())
  userId         Int
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  actorId        Int?
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  conversationId Int?
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, createdAt])
}

model ColdShowerEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  feeling   Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}
